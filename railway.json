{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "heroku.buildpacks",
    "buildpacks": [
      "heroku/php",
      "heroku/nodejs"
    ]
  },
  "deploy": {
    "startCommand": "vendor/bin/heroku-php-apache2 public/",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/"
  }
}
